# ==============================================================================
# LEGAKU — Environment Configuration (Production & Staging)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Supabase (Client-Safe — Bundled by Vite)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Project Settings -> API
# Catatan: Jika variabel ini kosong, LEGAKU secara otomatis berjalan dalam 
# Interactive Demo Mode dengan penyimpanan lokal (aman untuk preview dan testing).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Production URL & Domain
# ------------------------------------------------------------------------------
VITE_APP_URL=https://app.legaku.com

# ------------------------------------------------------------------------------
# 3. Server-Side / Edge Function / Webhook Secret (DO NOT EXPOSE WITH VITE_*)
# ------------------------------------------------------------------------------
# Hanya dipasang di Supabase Edge Functions / Secret Manager backend:
SUPABASE_URL=https://your-project-id.supabase.co
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_RECEIPT_MODEL=gemini-3.8-flash

# Midtrans / Xendit Payment Gateway (Production / Sandbox)
PAYMENT_GATEWAY_SERVER_KEY=your-payment-server-key-here
PAYMENT_WEBHOOK_SECRET=your-webhook-signature-secret-here
